# Copy to .env beside docker-compose.yml, or to backend/.env for local runs.
NEXUS_ENV=dev
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXUS_JWT_SECRET=
# Used by docker-compose for its database.
POSTGRES_PASSWORD=
# Local default is SQLite. For PostgreSQL: postgresql+psycopg://nexus:PASSWORD@localhost:5432/nexus
NEXUS_DATABASE_URL=sqlite:///./nexus.db
# Optional. Without a key NEXUS uses its rule-based extractor and templated summaries.
OPENAI_API_KEY=
NEXUS_OPENAI_MODEL=gpt-4o-mini
# Purchases above this amount need an admin instead of an approver.
NEXUS_PO_ADMIN_THRESHOLD=5000
